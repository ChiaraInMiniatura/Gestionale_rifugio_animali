// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Questo file è la fonte di verità dello schema del database: da qui Prisma
// genera sia il client TypeScript tipizzato (src/generated/prisma, gitignored,
// da rigenerare con `npx prisma generate` dopo ogni pull) sia le migrazioni
// SQL versionate in prisma/migrations/.

// Generator "prisma-client" (Prisma 7): sostituisce il vecchio
// "prisma-client-js". L'output non va mai modificato a mano.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// La stringa di connessione arriva da DATABASE_URL, definita in .env
// (mai committato nel repository).
datasource db {
  provider = "postgresql"
}

/// Ruoli applicativi: VOLONTARIA opera quotidianamente sui dati (animali,
/// cartelle sanitarie); ADMIN inoltre approva i nuovi account e gestisce
/// i cambi di stato delle adozioni. Un nuovo utente nasce sempre VOLONTARIA.
enum Role {
  /// Ruolo di default per i nuovi account.
  VOLONTARIA
  /// Ruolo con permessi aggiuntivi: approvazione account, cambio stato
  /// animali, eliminazioni.
  ADMIN
}

/// Account di accesso all'applicazione (volontarie e admin del rifugio).
model User {
  id        Int      @id @default(autoincrement())
  /// Univoca: usata come identificativo di login.
  email     String   @unique
  /// Hash bcrypt, mai testo in chiaro: la verifica avviene solo lato
  /// server, nel provider Credentials di Auth.js.
  password  String
  name      String
  /// Determina i permessi; default VOLONTARIA per i nuovi account.
  role      Role     @default(VOLONTARIA)
  /// Gate di sicurezza: un nuovo utente nasce con approved=false e non
  /// può accedere finché un ADMIN non lo approva esplicitamente. Questo
  /// valore viene sempre riletto dal DB ad ogni richiesta (mai fidato
  /// dal solo JWT di sessione), così una revoca è immediata.
  approved  Boolean  @default(false)
  /// Ad uso esclusivo dell'ADMIN, mai visibile alla volontaria stessa:
  /// numero di telefono e osservazioni pratiche di gestione (es.
  /// disponibilità, difficoltà). Testo libero, nessuna validazione di
  /// formato — stessa scelta già fatta per "documento" sull'adottante.
  cellulare String?
  note      String?
  createdAt DateTime @default(now())
}

/// Ciclo di vita dell'animale nel rifugio. Il cambio di stato è
/// un'operazione separata dagli altri campi anagrafici (vedi CAMPI_BASE
/// in src/app/api/animali/[id]/route.ts) ed è riservata agli ADMIN.
enum StatoAnimale {
  /// Stato di default alla creazione: l'animale è al rifugio e adottabile.
  DISPONIBILE
  /// L'animale è temporaneamente in affido, non ancora adottato.
  IN_AFFIDO
  /// L'animale è stato adottato definitivamente.
  ADOTTATO
}

/// Pensato per un'estensione futura oltre ai soli cani: oggi il rifugio
/// ospita solo cani, ma il modello è già pronto per altre specie.
enum Specie {
  /// Valore di default per i nuovi animali.
  CANE
  GATTO
  ALTRO
}

/// Sesso biologico dell'animale. Non include un valore "non noto": quel
/// caso è rappresentato da null sul campo opzionale Sesso? del modello
/// Animale, per non sporcare l'enum con uno pseudo-stato.
enum Sesso {
  MASCHIO
  FEMMINA
}

/// Scheda di un animale ospitato nel rifugio: dati anagrafici, stato di
/// adozione e foto opzionale.
model Animale {
  id           Int          @id @default(autoincrement())
  nome         String
  /// Default CANE: coerente con il fatto che oggi il rifugio ospita
  /// solo cani, pur lasciando aperta l'estensione ad altre specie.
  specie       Specie       @default(CANE)
  razza        String?
  /// Numero del microchip identificativo, se noto: testo libero (non
  /// validato in un formato specifico, i lettori/produttori variano),
  /// facoltativo come "razza".
  microchip    String?
  /// Opzionale e indicativa se non nota con precisione: da qui si
  /// calcola l'età (src/lib/eta.ts), mai salvata come valore a parte
  /// per evitare che diventi disallineata nel tempo.
  dataNascita  DateTime?
  descrizione  String?
  note         String?
  /// Data URL base64 (non un path a storage esterno): scelta semplice,
  /// ma limitata dalla soglia FOTO_MAX_LENGTH validata lato Zod, oltre
  /// alla compressione già applicata lato client prima dell'invio.
  foto         String?
  /// Opzionale: null = non noto, non un terzo valore dell'enum Sesso
  /// (vedi sopra).
  sesso        Sesso?
  /// Booleano nullable per rappresentare tre stati: true / false / non
  /// specificato (null) — stessa scelta fatta per "sesso".
  sterilizzato Boolean?
  /// Default DISPONIBILE; il cambio successivo è un'operazione ADMIN-only
  /// separata dagli altri campi (vedi CAMPI_BASE in [id]/route.ts).
  stato        StatoAnimale @default(DISPONIBILE)
  createdAt    DateTime     @default(now())
  /// Aggiornato automaticamente da Prisma ad ogni modifica del record.
  updatedAt    DateTime     @updatedAt
  /// Cartella clinica dell'animale: uno-a-molti, si somma nel tempo e non
  /// si sostituisce mai (ogni evento resta come storico).
  eventiClinici EventoClinico[]
  /// Storico affidi/adozioni: stesso principio di eventiClinici, si
  /// accumula nel tempo (più cicli affido/adozione/rientro sullo stesso
  /// animale restano tutti visibili).
  adozioni      Adozione[]
}

/// Categoria dell'evento clinico. Determina solo la classificazione in
/// elenco/dashboard: la semantica di data/dataScadenza/dataFine dipende
/// invece da "ricorrenza", non dal tipo (una TERAPIA può in teoria essere
/// puntuale, anche se il caso d'uso tipico è GIORNALIERA).
enum TipoEvento {
  VACCINO
  ANTIPARASSITARIO
  VISITA
  TERAPIA
}

/// Distingue eventi puntuali da terapie continuative: da questo dipende
/// quale coppia di campi (dataScadenza vs dataFine) è valorizzabile su
/// EventoClinico — vincolo di mutua esclusione applicato lato Zod
/// (src/lib/validations/evento-clinico.ts), non esprimibile qui a livello
/// di schema.
enum RicorrenzaEvento {
  /// Evento singolo (vaccino, antiparassitario, visita): usa dataScadenza
  /// per l'eventuale richiamo, mai dataFine.
  NESSUNA
  /// Terapia continuativa (tipicamente TERAPIA): usa dataFine per
  /// l'eventuale interruzione nota in anticipo, mai dataScadenza.
  GIORNALIERA
  /// Si ripete ogni mese: né dataScadenza né dataFine, alla conferma
  /// l'app genera da sola il prossimo evento della stessa serie (data +
  /// 1 mese) — vedi campo "prossimoGenerato" su EventoClinico sotto.
  MENSILE
  /// Come MENSILE, ma ogni anno (data + 1 anno) — tipico per i vaccini.
  ANNUALE
}

/// Singola voce della cartella clinica di un animale. La coppia di campi
/// realmente in uso dipende da "ricorrenza" (vedi enum sopra): il vincolo
/// di mutua esclusione tra dataScadenza e dataFine è applicato solo lato
/// Zod, non con un CHECK a livello di database.
model EventoClinico {
  id            Int              @id @default(autoincrement())
  animaleId     Int
  /// onDelete: Cascade — eliminando un animale si elimina anche tutta la
  /// sua cartella clinica: scelta esplicita (non RESTRICT), confermata
  /// perché un evento clinico non ha senso "orfano" senza l'animale a
  /// cui si riferisce. Il popup di conferma su elimina-animale-button
  /// avverte l'utente quando ci sono eventi collegati.
  animale       Animale          @relation(fields: [animaleId], references: [id], onDelete: Cascade)
  tipo          TipoEvento
  /// Testo libero (es. "Trivalente", "Advantix", "Antibiotico X 2
  /// volte/die"): i tipi sono poche categorie ampie, il nome specifico
  /// del prodotto/prestazione varia troppo per meritare un enum.
  nomeSpecifico String
  /// Include sempre l'orario, non solo il giorno: utile in particolare
  /// per le visite veterinarie, dove l'ora dell'appuntamento è
  /// un'informazione pratica da ricordare. Per ricorrenza=GIORNALIERA
  /// rappresenta il giorno di inizio terapia (l'orario è ignorato in UI).
  data          DateTime
  /// Solo per ricorrenza=NESSUNA: prossimo richiamo/visita. Deve restare
  /// null per le terapie giornaliere (vedi RicorrenzaEvento).
  dataScadenza  DateTime?
  ricorrenza    RicorrenzaEvento @default(NESSUNA)
  /// Solo per ricorrenza=GIORNALIERA: giorno di interruzione nota in
  /// anticipo. null = terapia ancora in corso, nessun termine previsto.
  /// Deve restare null per gli eventi non ricorrenti.
  dataFine      DateTime?
  /// Per ricorrenza NESSUNA/MENSILE/ANNUALE: false finché un appuntamento
  /// futuro non viene confermato come avvenuto (bottone dedicato, non un
  /// popup: è un'azione reversibile, non distruttiva). Sostituisce
  /// l'euristica precedente basata su createdAt/data, poco chiara.
  /// Default true: copre sia gli eventi già passati al momento della
  /// creazione (log retrospettivi, nulla da confermare) sia i record già
  /// esistenti prima di questa migrazione. Non utilizzato per
  /// ricorrenza=GIORNALIERA. Per MENSILE/ANNUALE, la transizione a
  /// true è anche il momento in cui si genera il prossimo evento della
  /// serie (vedi prossimoGenerato sotto).
  confermato    Boolean          @default(true)
  /// Solo per ricorrenza MENSILE/ANNUALE: true dopo che è già stato
  /// generato l'evento successivo della stessa serie. Guardia contro i
  /// duplicati: se l'evento viene confermato, poi annullato, poi
  /// riconfermato più volte, il rinnovo automatico scatta una sola
  /// volta, non ad ogni conferma. Ignorato per le altre ricorrenze.
  prossimoGenerato Boolean       @default(false)
  note          String?
  createdAt     DateTime         @default(now())
  /// Aggiornato automaticamente da Prisma ad ogni modifica del record.
  updatedAt     DateTime         @updatedAt
  /// Istantanee dei valori precedenti ad ogni modifica "vera" (non il
  /// tocco di conferma/annulla conferma): si accumulano nel tempo come
  /// EventoClinico stesso rispetto ad Animale.
  storico       EventoClinicoStorico[]
}

/// Istantanea dei valori di un evento clinico subito PRIMA di una
/// modifica "vera" (tramite EventoClinicoForm) — non generata dal
/// semplice PATCH di conferma/annulla conferma, troppo frequente e non
/// rilevante come "modifica" del contenuto clinico. onDelete: Cascade da
/// EventoClinico, stesso principio già usato altrove: eliminare l'evento
/// elimina anche il suo storico. Nessun campo su "chi" ha modificato,
/// solo cosa e quando (scelta deliberata).
model EventoClinicoStorico {
  id            Int              @id @default(autoincrement())
  eventoId      Int
  evento        EventoClinico    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  tipo          TipoEvento
  nomeSpecifico String
  data          DateTime
  dataScadenza  DateTime?
  ricorrenza    RicorrenzaEvento
  dataFine      DateTime?
  confermato    Boolean
  note          String?
  /// Quando è stata fatta la modifica che ha reso obsoleta questa
  /// istantanea (non quando l'evento originale fu creato).
  modificatoIl  DateTime         @default(now())
}

/// Distingue un affido temporaneo da un'adozione definitiva sullo stesso
/// record: quando un affido si trasforma in adozione, il record esistente
/// cambia tipo invece di crearne uno nuovo (la relazione con quella
/// persona è la stessa, cambia solo la sua natura).
enum TipoRapporto {
  AFFIDO
  ADOZIONE
}

/// Rapporto tra un animale e la persona che lo ha in affido o lo ha
/// adottato. Si accumula nel tempo come EventoClinico: un nuovo rapporto
/// (persona diversa, o stessa persona dopo un rientro) crea una nuova
/// riga, non sovrascrive la precedente — così la cronologia resta
/// leggibile anche con più cicli affido/adozione/rientro sullo stesso
/// animale.
model Adozione {
  id         Int          @id @default(autoincrement())
  animaleId  Int
  /// onDelete: Cascade, stesso principio di EventoClinico — eliminare
  /// l'animale elimina anche il suo storico di affidi/adozioni.
  animale    Animale      @relation(fields: [animaleId], references: [id], onDelete: Cascade)
  tipo       TipoRapporto
  nome       String
  cognome    String
  cellulare  String
  /// Estremi del documento d'identità (tipo + numero, es. "CI AB1234567"):
  /// dato sensibile, per questo la creazione/modifica di Adozione resta
  /// ADMIN-only come il cambio di stato a cui è collegata, mai
  /// visibile/modificabile dalle VOLONTARIA.
  documento  String
  dataInizio DateTime
  /// null = rapporto ancora in corso (l'animale non è tornato al
  /// rifugio); valorizzata quando l'ADMIN riporta lo stato a
  /// DISPONIBILE, chiude questo record.
  dataFine   DateTime?
  note       String?
  createdAt  DateTime     @default(now())
  /// Aggiornato automaticamente da Prisma ad ogni modifica del record.
  updatedAt  DateTime     @updatedAt
}

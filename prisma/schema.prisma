// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VOLONTARIA
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(VOLONTARIA)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum StatoAnimale {
  DISPONIBILE
  IN_AFFIDO
  ADOTTATO
}

enum Specie {
  CANE
  GATTO
  ALTRO
}

enum Sesso {
  MASCHIO
  FEMMINA
}

model Animale {
  id           Int          @id @default(autoincrement())
  nome         String
  specie       Specie       @default(CANE)
  razza        String?
  dataNascita  DateTime?
  descrizione  String?
  note         String?
  foto         String?
  sesso        Sesso?
  sterilizzato Boolean?
  stato        StatoAnimale @default(DISPONIBILE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}
